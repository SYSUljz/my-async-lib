---
# Optimized Google/Chromium Hybrid Format for Modern Linux C++20 Server
Language: Cpp
BasedOnStyle: Google
Standard: Latest
DerivePointerAlignment: false
ColumnLimit: 120

# Chromium Safety Enhancements
InsertBraces: true
InsertNewlineAtEOF: true
SpaceBeforeCpp11BracedList: true

# Clean 4-Tier Linux/POSIX Include Ordering
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<[a-zA-Z0-9_]*\.h>'
    Priority: 1
  - Regex: "^<[a-zA-Z0-9_/]*>"
    Priority: 2
  - Regex: "^<.*"
    Priority: 3
  - Regex: ".*"
    Priority: 4

IncludeIsMainRegex: "(_test)?$"
---
Language: Proto
BasedOnStyle: Google
---
Language: Json
IndentWidth: 2
